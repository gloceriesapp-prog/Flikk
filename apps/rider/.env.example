# Rider app environment. Copy to .env.local for LOCAL development only.
# Never commit .env / .env.local (see .gitignore).
#
# Where each environment gets its values:
#   local       this file (.env.local) — `npm run local:setup` writes it for you
#   preview     expo.dev → rider → Environment variables → preview    (staging API)
#   production  expo.dev → rider → Environment variables → production (live API)
# EAS cloud builds never read .env.local; release values live only on expo.dev.

# ─── API ────────────────────────────────────────────────────────────────────
# Local: your backend on port 4000. localhost is fine — in development the app
# swaps the host for your computer's LAN IP automatically (it follows the
# Metro host, src/api/baseUrl.ts), so it keeps working when your Wi-Fi IP
# changes. A hard-coded LAN IP (http://192.168.x.x:4000) also works.
# preview/production (expo.dev): https://<railway domain> — release builds
# refuse anything that is not public https (packages/shared/config/api-url.cjs).
EXPO_PUBLIC_API_URL=http://localhost:4000

# Local only. Set false when the backend runs on a DIFFERENT computer than
# Metro (then put that computer's LAN IP in EXPO_PUBLIC_API_URL). Ignored in
# release builds.
EXPO_PUBLIC_API_FOLLOW_METRO_HOST=true

# ─── Maps ───────────────────────────────────────────────────────────────────
# Google Cloud → APIs & Services → Credentials → key restricted to
# "Maps SDK for Android" + package com.gloceries.rider + SHA-1 fingerprints:
# the upload key AND the Play app-signing key (Play Console → App integrity),
# or the delivery map is blank in the Play Store build. Use the SDK key for this app; never the backend Geocoding key.
ANDROID_GOOGLE_MAPS_API_KEY=
# Legacy GOOGLE_MAPS_API_KEY is still accepted when the Android name is unset.
# GOOGLE_MAPS_API_KEY=

# Optional. Separate key restricted to "Maps SDK for iOS" + bundle ID
# com.gloceries.rider. Empty = iOS uses Apple Maps.
IOS_ANDROID_GOOGLE_MAPS_API_KEY=
# Legacy GOOGLE_MAPS_API_KEY is still accepted when the Android name is unset.
# GOOGLE_MAPS_API_KEY=

# ─── Push (Android FCM) ─────────────────────────────────────────────────────
# Leave unset locally: config/firebase/google-services.json is used. On EAS,
# a file-type variable named GOOGLE_SERVICES_JSON overrides it.
# GOOGLE_SERVICES_JSON=

# Do not add GOOGLE_GEOCODING_API_KEY here. Geocoding and routes use backend
# credentials; map SDK keys are embedded in the native binary and restricted
# by Android package + signing SHA-1, or the iOS bundle identifier.

# Supported Android SDK alias; configure only one native Android key name.
# Keep server Geocoding/Routes credentials out of this app.
GOOGLE_GEOCODING_MAP_KEY=
