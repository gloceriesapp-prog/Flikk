# Copy to .env and fill in real values. Never commit .env — see .gitignore.

# The backend's real address — Express listens on 4000 (backend/.env.local's
# PORT), not 3000 (that's apps/admin's Next.js dev server). Use your Mac's
# LAN IP (`ipconfig getifaddr en0`), not "localhost" — a physical phone on
# the same Wi-Fi can't resolve your Mac's own localhost. Leaving this unset
# silently falls back to api/client.ts's own default (http://localhost:3000)
# and every request quietly hits nothing real.
EXPO_PUBLIC_API_URL=http://<your-mac-lan-ip>:4000

# Google Cloud Console → APIs & Services → Credentials → key restricted to
# "Maps SDK for Android" + this app's package name (com.gloceries.partner) and
# SHA-1 fingerprint. iOS uses Apple Maps unless its optional key is configured.
ANDROID_GOOGLE_MAPS_API_KEY=
# Legacy GOOGLE_MAPS_API_KEY is still accepted when the Android name is unset.
# GOOGLE_MAPS_API_KEY=

# Optional: separate Maps SDK for iOS key restricted to com.gloceries.partner.
# Empty keeps Apple Maps. Changing a native map key requires a new binary.
IOS_GOOGLE_MAPS_API_KEY=

# Mappls (MapmyIndia) client_id/client_secret do NOT belong in this file —
# they're OAuth2 credentials that must never ship inside the app bundle.
# They live in /backend's own .env; this app only ever calls /backend's
# /location/search and /location/reverse endpoints, never Mappls directly.
# See /backend/.env.example once those endpoints exist.

# Crash reporting (Sentry → project for the partner app). The DSN is safe to
# ship in the app; leave it empty to keep Sentry off. ORG/PROJECT enable
# source-map upload during EAS builds; SENTRY_AUTH_TOKEN belongs in EAS
# secrets, never in this file.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Do not add GOOGLE_GEOCODING_API_KEY here. Geocoding and routes use backend
# credentials; map SDK keys are embedded in the native binary and restricted
# by Android package + signing SHA-1, or the iOS bundle identifier.

# Supported Android SDK alias; configure only one native Android key name.
# Keep server Geocoding/Routes credentials out of this app.
GOOGLE_GEOCODING_MAP_KEY=
