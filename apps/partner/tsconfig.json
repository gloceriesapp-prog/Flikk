{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // 'node' so the *.selfcheck.ts scripts (run via `npx tsx`, not bundled)
    // typecheck their node:assert/console/process usage — same as
    // apps/customer's tsconfig. RN/Expo types come from their own bundled
    // d.ts via imports, not @types global injection, so this doesn't drop them.
    "types": ["node"],
    "paths": {
      "react-native": [
        "./node_modules/react-native",
        "../../node_modules/react-native"
      ]
    }
  }
}
