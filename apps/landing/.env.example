# Public values only — every NEXT_PUBLIC_ var is shipped to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=

# Search console verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Legal / contact details shown on /contact, /privacy, /terms, /refund-policy,
# /shipping-policy (src/lib/legal/company.ts). Unset rows are hidden, but payment
# gateways expect at least a support email, phone and registered address.
NEXT_PUBLIC_SUPPORT_EMAIL=
# E.164 format, e.g. +919876543210
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_REGISTERED_ADDRESS=
NEXT_PUBLIC_COMPANY_CIN=
NEXT_PUBLIC_COMPANY_GSTIN=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
# Defaults to NEXT_PUBLIC_SUPPORT_EMAIL when unset
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=
