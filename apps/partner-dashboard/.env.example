# Backend API base URL (no trailing slash). Must also be allowed in the
# backend's WEB_DASHBOARD_ORIGINS for CORS.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Support channels shown on Help. Unset = that channel is hidden.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
# Digits only, with country code, e.g. 919876543210
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Local design aid only (ignored in production builds): show demo data on
# pages with no real data.
NEXT_PUBLIC_DEMO_DATA=false
