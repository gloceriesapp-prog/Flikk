{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "outDir": "."
  },
  "include": [
    "src"
  ],
  "exclude": []
}
