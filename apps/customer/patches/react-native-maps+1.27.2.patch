+// Gloceries patch: GMSMapView throws (and crashes the app) when the minimum
+// zoom is above the maximum. Fabric props start at 0, so a min zoom can
+// arrive while the max is still 0. Treat an unset or lower max as "no limit".
+- (void)setMinZoom:(float)minZoom maxZoom:(float)maxZoom {
+  float min = MAX(minZoom, kGMSMinZoomLevel);
+  float max = (maxZoom <= 0 || maxZoom < min) ? kGMSMaxZoomLevel : maxZoom;
+  [super setMinZoom:MIN(min, max) maxZoom:max];
+}
+
 - (void)setMinZoom:(CGFloat)minZoomLevel {
   [self setMinZoom:minZoomLevel maxZoom:self.maxZoom ];
 }
