EXPO_PUBLIC_API_URL=http://localhost:4000
# Local development: Metro and the backend run on the same computer.
# Set false when using a backend on a different LAN computer.
EXPO_PUBLIC_API_FOLLOW_METRO_HOST=true

# Google Cloud Console → APIs & Services → Credentials → key restricted to
# "Maps SDK for Android" + this app's package name (com.gloceries.customer) and
# SHA-1 fingerprint (`eas credentials` prints it). Android-only.
ANDROID_GOOGLE_MAPS_API_KEY=
# Existing GOOGLE_MAPS_API_KEY remains supported. If both names are set,
# their values must match. Never put GOOGLE_GEOCODING_API_KEY in an app.
# Set this in the matching EAS environment, then rebuild native binaries.

# Same Google Cloud project, separate key restricted to "Maps SDK for iOS" +
# this app's bundle ID (com.gloceries.customer). Optional — leave empty and iOS
# falls back to Apple Maps (app.config.js's own note); once this is set AND
# a fresh `eas build` ships, LocationSearchScreen.tsx automatically switches
# iOS to real Google Maps + the same grayscale style Android already uses —
# no further code change needed.
IOS_GOOGLE_MAPS_API_KEY=

# Public DSN (not a secret). Required for monitored release builds.
EXPO_PUBLIC_SENTRY_DSN=
# Configure these in EAS build environment; auth token must be secret and never EXPO_PUBLIC.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Public Supabase project URL — shipped artwork URLs (src/utils/storageUrl.ts).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Payment key ID, environment and amount come from the authenticated backend.
# Never place gateway key secrets or webhook secrets in EXPO_PUBLIC_* variables.

# Supported Android SDK alias; configure only one native Android key name.
# Keep server Geocoding/Routes credentials out of this app.
GOOGLE_GEOCODING_MAP_KEY=
