# Copy to .env and fill in real values. Never commit .env — see .gitignore.

# Backend/Express listens on 4000, not 3000 (apps/admin's Next.js dev
# server owns 3000). Real value is your machine's LAN IP, not localhost —
# a physical device can't reach your laptop's loopback address.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google Cloud Console → APIs & Services → Credentials → key restricted to
# "Maps SDK for Android" + this app's package name (com.gloceries.rider) and
# SHA-1 fingerprint. Android-only — iOS uses Apple Maps by default, no key.
GOOGLE_MAPS_API_KEY=

# EAS project id (`eas init`, then `eas project:info`) — required for
# preview/production builds; rider push tokens are tied to it.
EAS_PROJECT_ID=
