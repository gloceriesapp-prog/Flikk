# Which database this backend talks to. NEVER production from a laptop:
#   local   -> http://127.0.0.1:54321 (supabase start; keys from `supabase status`)
#   staging -> https://qgbuvydwcgjthwqxqylk.supabase.co (flikk-staging)
# The backend refuses the production project unless NODE_ENV=production or
# ALLOW_PRODUCTION_DATABASE=true. See ENVIRONMENTS.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cashfree PG (customer payments). Optional until the account is live — set
# APP_ID + SECRET_KEY together or neither. Missing: the backend boots
# COD-only, GET /payments/availability returns { online: false }, the
# create-order / upi/intent / upi/collect / verify / webhook endpoints return
# 503 PAYMENTS_NOT_CONFIGURED, and pre-expiry reconciliation + refund workers
# no-op. Dashboard -> Developers -> API keys. (CASHFREE_CLIENT_ID /
# CASHFREE_CLIENT_SECRET are accepted as aliases.)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production. Anything else refuses to boot.
CASHFREE_ENV=sandbox
# Webhook: POST <PUBLIC_API_URL>/payments/webhook, events PAYMENT_SUCCESS,
# PAYMENT_FAILED, PAYMENT_USER_DROPPED, REFUND_STATUS (payload version
# 2025-01-01). Cashfree signs with the PG secret key; leave empty to use
# CASHFREE_SECRET_KEY.
CASHFREE_WEBHOOK_SECRET=
# Payment methods and the minimum order value are admin settings (admin
# "Checkout settings" page, platform_settings, migration 117). These are hard
# kill switches on top: 'true' turns the method off whatever admin saved.
COD_DISABLED=false
ONLINE_PAYMENTS_DISABLED=false
# Public base URL of this API (no trailing slash); sent as each order's
# notify_url. Empty = only the dashboard-configured webhook is used.
PUBLIC_API_URL=
# Optional Secure ID (Verification Suite) keys for UPI ID name lookup in
# POST /payments/upi/validate. Empty = format-only check (name: null).
# Note: the lookup is Cashfree's UPI penny-drop API, billed per call.
CASHFREE_VERIFICATION_CLIENT_ID=
CASHFREE_VERIFICATION_SECRET=
WHATSAPP_API_KEY=
# Login OTP SMS (customer, partner and rider apps) via MSG91. The backend
# generates, sends and checks the code itself (src/auth/loginOtp.ts,
# src/lib/msg91.ts); Supabase only issues the session afterwards. No Supabase
# SMS provider or hook is needed. Without these keys in local development the
# code is printed in the backend log. Doorstep delivery OTPs are separate.
# MSG91 -> API -> Auth key. Turn off the key's IP whitelist (or whitelist
# the backend's outbound IPs), otherwise MSG91 answers 401.
MSG91_AUTH_KEY=
# MSG91 -> SMS -> Templates -> Template ID of the "Verified by DLT" login
# template (the 24-character MSG91 ID, not the 19-digit DLT template ID).
MSG91_OTP_TEMPLATE_ID=
# Variable in that template that holds the code: ##OTP## -> OTP (default).
MSG91_OTP_VARIABLE=OTP
# flow (default) sends SMS-section templates; set otp only for a template
# created under MSG91 -> OTP.
MSG91_API=flow
# Numbers that log in with a fixed code and never get an SMS, e.g. the Google
# Play reviewer: 919100000001=123456,919100000002=654321. Unset in local
# development = 9100000001/2/3 with 123456; unset in production = none.
LOGIN_TEST_OTPS=
# Only for the legacy Supabase Send SMS hook (POST /auth/hooks/send-sms).
# Login does not use it any more; leave empty unless that hook is enabled.
SEND_SMS_HOOK_SECRET=
# 4000, not 3000 — admin's Next.js dev server already claims 3000, and the
# two running at once (backend started, then `pnpm dev` in apps/admin) is
# the actual cause behind "requests silently fail" bugs: whichever started
# second either fails to bind or the other server answers with its own
# unrelated 404 instead of a real API response.
EXPO_ACCESS_TOKEN=
PORT=4000
MAPPLS_ACCESS_TOKEN=
# Google Cloud Console -> APIs & Services -> enable "Geocoding API" ->
# Credentials -> create a key, restrict it to IP addresses (this server's
# IP; the "Android app" restriction type does NOT work for this REST API,
# only for the Maps SDK). A different key from apps/*/GOOGLE_MAPS_API_KEY
# — that one is Android-app-restricted for the Maps SDK, this one is
# IP-restricted for a server-to-server REST call, they're not
# interchangeable. Optional — /location/reverse-geocode degrades cleanly
# without it (see env.ts's own note).
GOOGLE_GEOCODING_API_KEY=

# Per-replica SSE admission; tune only from staging connection/fan-out tests.
SSE_MAX_CONNECTIONS=2000
# Shared mobile/NAT users may share an IP. Configure trusted proxies explicitly.
SSE_MAX_CONNECTIONS_PER_IP=100

# Number of reverse-proxy hops in front of this server whose X-Forwarded-For
# Express should trust (sets app.set('trust proxy', N)). Default 0 = req.ip is
# the proxy's own address, so EVERY user shares one IP bucket for the OTP
# send/verify limits and SSE per-IP caps (one abuser locks everyone out).
#   Railway / Render / Fly / Heroku (one load balancer): 1
#   Cloudflare in front of Railway/Render: 2
#   Local dev / direct connection: 0
# Never set higher than the real hop count — clients could then spoof
# X-Forwarded-For to dodge the per-IP limit. Unset on Railway defaults to 1
# (RAILWAY_ENVIRONMENT is present). NODE_ENV=production with 0 refuses to boot
# unless ALLOW_DIRECT_CLIENT_IP=true (no proxy in front at all).
TRUST_PROXY_HOPS=0

# Server-only public image storage. Never prefix credentials with NEXT_PUBLIC/EXPO_PUBLIC.
R2_ACCOUNT_ID=f06edcade7a6bfb879b47eec02d5bf69
R2_ENDPOINT=https://f06edcade7a6bfb879b47eec02d5bf69.r2.cloudflarestorage.com
R2_BUCKET_NAME=gloceries-public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Promotional delivery is disabled until approved senders are configured.
PROMOTIONS_ENABLED=false
RESEND_API_KEY=
PROMOTIONAL_EMAIL_FROM=
# Promotional SMS is not supported: DLT allows only pre-approved templates.
