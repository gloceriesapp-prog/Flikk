{
  "name": "gloceries-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "dev:worker": "tsx watch --env-file=.env.local src/workers/index.ts",
    "start:worker": "node dist/workers/index.js",
    "db:status": "node scripts/db-migrate.mjs --status",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-migrate.mjs --seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@supabase/supabase-js": "^2.112.3",
    "compression": "^1.8.1",
    "express": "^4.19.2",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.4",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
